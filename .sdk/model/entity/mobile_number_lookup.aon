# Entity: mobile_number_lookup

main: kit: entity: mobile_number_lookup: {

  alias: field: {}

  fields: [
    {
      name: "country"
      req: true
      type: "`$OBJECT`"
    }
    {
      name: "id"
      req: true
      short: "Operator identifier."
      type: "`$INTEGER`"
    }
    {
      name: "identified"
      req: true
      short: "Indicates whether operator was identified as a direct match"
      type: "`$BOOLEAN`"
    }
    {
      name: "mobile_number"
