              }
            ]
          }
          method: "GET"
          orig: "/lookup/mobile-number/{mobile_number}"
          parts: [
            "lookup"
            "mobile-number"
            "{mobile_number}"
          ]
          select: {
            exist: [
              "mobile_number"
              "page"
              "per_page"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/lookup/mobile-number"
          parts: [
            "lookup"
            "mobile-number"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
