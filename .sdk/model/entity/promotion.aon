      req: true
      type: "`$ARRAY`"
    }
    {
      name: "start_date"
      req: true
      type: "`$STRING`"
    }
    {
      name: "terms"
      req: true
      type: "`$STRING`"
    }
    {
      name: "title"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "promotion"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            header: [
              {
                example: "es"
                kind: "header"
                name: "accept_language"
                orig: "accept_language"
                reqd: false
                type: "`$STRING`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "country_iso_code"
                orig: "country_iso_code"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "operator_id"
                orig: "operator_id"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
