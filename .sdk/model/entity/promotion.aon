                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 50
                kind: "query"
                name: "per_page"
                orig: "per_page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "product_id"
                orig: "product_id"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/promotions"
          parts: [
            "promotions"
          ]
          select: {
            exist: [
              "accept_language"
              "country_iso_code"
              "operator_id"
              "page"
              "per_page"
              "product_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            header: [
              {
                example: "es"
                kind: "header"
                name: "accept_language"
                orig: "accept_language"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "promotion_id"
                orig: "promotion_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/promotions/{promotion_id}"
          parts: [
            "promotions"
            "{promotion_id}"
          ]
          select: {
            exist: [
              "accept_language"
              "promotion_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
