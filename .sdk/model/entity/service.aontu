# Entity: service

main: kit: entity: service: {

  alias: field: {}

  fields: {
    id: {
      fo: "int32"
      h: "Id"
      n: "id"
      r: true
      sh: "Service identifier."
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
    subservices: {
      h: "Subservices"
      n: "subservices"
      r: true
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "service"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /services"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "country_iso_code"
                or: "country_iso_code"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 50
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/services"
          q: {
            exist: [
              "country_iso_code"
              "page"
              "per_page"
            ]
          }
          s: [
            {
              lit: "services"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /services/{service_id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "service_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/services/{service_id}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              service_id: "id"
            }
          }
          s: [
            {
              lit: "services"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
