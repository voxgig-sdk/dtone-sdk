          contract: {
            id: "GET /transactions"
            json: "{\"operationId\":\"getTransactions\",\"parameters\":[{\"description\":\"Unique identifier for the transaction in your system.\",\"in\":\"query\",\"name\":\"external_id\",\"schema\":{\"minLength\":1,\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"product_type\",\"required\":false,\"schema\":{\"enum\":[\"FIXED_VALUE_RECHARGE\",\"RANGED_VALUE_RECHARGE\",\"FIXED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PAYMENT\"],\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"service_id\",\"required\":false,\"schema\":{\"description\":\"Service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}},{\"in\":\"query\",\"name\":\"subservice_id\",\"required\":false,\"schema\":{\"description\":\"Sub-service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}},{\"in\":\"query\",\"name\":\"country_iso_code\",\"required\":false,\"schema\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"operator_id\",\"required\":false,\"schema\":{\"description\":\"Operator identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}},{\"in\":\"query\",\"name\":\"status_id\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"in\":\"query\",\"name\":\"credit_party_mobile_number\",\"required\":false,\"schema\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"credit_party_account_number\",\"required\":false,\"schema\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},{\"description\":\"Starting date to filter transactions based on creation date, inclusive of the provided date. Please note that the window between `from_date` and `to_date` can not exceed 24 hours.\",\"example\":\"1970-01-01T00:00:00.000000Z\",\"in\":\"query\",\"name\":\"from_date\",\"required\":false,\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"Ending date to filter transactions based on creation date, inclusive of the provided date. Please note that the window between `from_date` and `to_date` can not exceed 24 hours.\",\"example\":\"2020-02-02T14:00:00.022220+08:00\",\"in\":\"query\",\"name\":\"to_date\",\"required\":false,\"schema\":{\"format\":\"date-time\",\"type\":\"string\"}},{\"description\":\"Page number.\",\"in\":\"query\",\"name\":\"page\",\"required\":false,\"schema\":{\"default\":1,\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"Number of records per page.\",\"in\":\"query\",\"name\":\"per_page\",\"required\":false,\"schema\":{\"default\":50,\"format\":\"int32\",\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"items\":{\"allOf\":[{\"properties\":{\"additional_identifier\":{\"description\":\"Additional details for a transaction. This information is mostly optional and will be required primarily for compliance reasons for products with additional information requirements as outlined in `required_additional_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"purchaser_id\":{\"description\":\"Anonymized ID related to the purchase for compliance reasons (e.g. terminal, POS, agent, end user, etc).\",\"pattern\":\"^[a-zA-Z0-9\\\\-]{8,36}$\",\"type\":\"string\"}},\"type\":\"object\"},\"adjusted_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"auto_confirm\":{\"default\":false,\"description\":\"Determines whether a transaction will be automatically confirmed upon creation or not. This is opted-out by default. Setting this field to `true` is recommended when transaction details, e.g. prices, are known as it removes the need to perform a separate API call to [confirm transactions](#operation/postTransactionConfirmAsync).\",\"type\":\"boolean\",\"writeOnly\":true},\"beneficiary\":{\"description\":\"Beneficiary details for a transaction. This information is mostly optional and will only be required for products with beneficiary information requirements as outlined in `required_beneficiary_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"benefits\":{\"items\":{\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Base benefit amount. A value of `-1` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"format\":\"double\",\"type\":\"number\"},\"promotion_bonus\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"total_excluding_tax\":{\"format\":\"double\",\"type\":\"number\"},\"total_including_tax\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"additionalProperties\":false,\"description\":\"Base product benefits. A `-1` value for `min` or `max` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"promotion_bonus\":{\"additionalProperties\":false,\"description\":\"Additional product benefits from applicable promotions.\",\"properties\":{\"max\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"min\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_excluding_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions before taxes.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_including_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions after taxes. This field indicates the end benefits received by the end user.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"}]},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"calculation_mode\":{\"allOf\":[{\"enum\":[\"SOURCE_AMOUNT\",\"DESTINATION_AMOUNT\"],\"type\":\"string\"},{\"nullable\":true},{\"writeOnly\":true},{\"description\":\"Required when product type is either `RANGED_VALUE_RECHARGE`, `RANGED_VALUE_PIN_PURCHASE`, or `RANGED_VALUE_PAYMENT`\"}]},\"confirmation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"confirmation_expiration_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"creation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"credit_party_identifier\":{\"description\":\"Receiving account details for a transaction. This information will be required for the majority of products with credit party inofrmation requirements outlined in `required_credit_party_identifier_fields`, but will be optional for certain products without any upfront recipient, e.g. Gift Cards.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"debit_party_identifier\":{\"description\":\"Sending account details for a transaction. This information is mostly optional and will only be required for products with debit party information requirements as outlined in `required_debit_party_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"destination\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `DESTINATION_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"external_id\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"maxLength\":40},{\"description\":\"Unique identifier for the transaction in your system.\"}]},\"id\":{\"allOf\":[{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}],\"readOnly\":true},\"metadata\":{\"allOf\":[{\"discriminator\":{\"mapping\":{\"ESIM\":\"#/components/schemas/transaction_metadata_esim\"},\"propertyName\":\"type\"},\"oneOf\":[{\"additionalProperties\":false,\"description\":\"eSIM transaction metadata.\",\"properties\":{\"activation_type\":{\"description\":\"Type of activation performed.\",\"enum\":[\"DATA_PLAN\",\"TOP_UP\"],\"type\":\"string\"},\"balance\":{\"additionalProperties\":false,\"description\":\"Balance information for the activated eSIM data package.\",\"properties\":{\"country_set\":{\"description\":\"Country set code (e.g., WWW for worldwide).\",\"type\":\"string\"},\"extended_data_policy\":{\"additionalProperties\":false,\"description\":\"Enriched with runtime state for an activated pack. Always returned. For STANDARD plans, only the type field will be returned.\",\"properties\":{\"fixed_time\":{\"description\":\"Time of day (HH:MM in UTC) when high-speed volume resets. Only present when reset_type is FIXED_TIME. Typically midnight (\\\"00:00\\\") but may vary due to time zone differences (e.g., \\\"08:00\\\").\",\"example\":\"00:00\",\"nullable\":true,\"pattern\":\"^\\\\d{2}:\\\\d{2}$\",\"type\":\"string\"},\"interval\":{\"description\":\"Interval duration for high-speed volume reset. Only present when reset_type is TIME_INTERVAL. For example, \\\"24h\\\" means the high-speed volume resets every 24 hours from activation.\",\"example\":\"24h\",\"nullable\":true,\"type\":\"string\"},\"reset_type\":{\"allOf\":[{\"description\":\"Method for resetting the high-speed data volume. Determines whether the interval or fixed_time field is returned. TIME_INTERVAL: high-speed volume resets on a recurring interval from activation (see interval field). FIXED_TIME: high-speed volume resets at a specific time of day (see fixed_time field). NONE: high-speed volume does not reset.\",\"enum\":[\"TIME_INTERVAL\",\"FIXED_TIME\",\"NONE\"],\"nullable\":true,\"type\":\"string\"},{\"nullable\":true}]},\"throttle_speed\":{\"description\":\"Speed to throttle to after high-speed volume is used up.\",\"example\":\"128 KB/s\",\"nullable\":true,\"type\":\"string\"},\"total_high_speed_volume\":{\"additionalProperties\":false,\"description\":\"Total high-speed data volume before throttling. Only populated when extended_data_policy type is UNLIMITED.\",\"nullable\":true,\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"type\":{\"description\":\"Package type.\",\"enum\":[\"STANDARD\",\"UNLIMITED\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"size\":{\"additionalProperties\":false,\"description\":\"Total data size of the package.\",\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"validity\":{\"additionalProperties\":false,\"description\":\"Remaining validity of the package.\",\"properties\":{\"quantity\":{\"description\":\"Original validity size of the activated item.\",\"example\":365,\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of validity period.\",\"enum\":[\"YEAR\",\"MONTH\",\"WEEK\",\"DAY\",\"HOUR\",\"MINUTE\",\"SECOND\"],\"type\":\"string\"}},\"required\":[\"quantity\",\"unit\"],\"type\":\"object\"}},\"required\":[\"size\",\"validity\",\"country_set\",\"extended_data_policy\"],\"type\":\"object\"},\"profile\":{\"allOf\":[{\"additionalProperties\":false,\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\",\"nullable\":true,\"properties\":{\"activation_code\":{\"description\":\"QR code content for eSIM installation.\",\"type\":\"string\"},\"android_universal_link\":{\"description\":\"Universal link for eSIM installation on Android devices.\",\"format\":\"uri\",\"type\":\"string\"},\"apple_universal_link\":{\"description\":\"Universal link for eSIM installation on Apple devices.\",\"format\":\"uri\",\"type\":\"string\"},\"iccid\":{\"description\":\"Integrated Circuit Card Identifier.\",\"type\":\"string\"},\"installation_url\":{\"description\":\"Generic installation URL for the eSIM.\",\"format\":\"uri\",\"type\":\"string\"}},\"required\":[\"iccid\",\"activation_code\",\"apple_universal_link\",\"android_universal_link\",\"installation_url\"],\"type\":\"object\"}],\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\"},\"type\":{\"enum\":[\"ESIM\"],\"type\":\"string\"}},\"required\":[\"type\",\"activation_type\",\"balance\"],\"type\":\"object\"}]}],\"description\":\"Optional metadata related to the transaction. This can include any additional information that may be relevant\\nfor the transaction but is not covered by the other fields.\\nThe structure of this object can vary depending on the product type or service and specific use case.\\nFor example, for eSIM products, this field may contain additional details about the eSIM activation, balance and profile.\\n\",\"type\":\"object\"},\"operator_reference\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"readOnly\":true,\"type\":\"string\"},\"pin\":{\"nullable\":true,\"properties\":{\"code\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"serial\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"required\":[\"code\",\"serial\"],\"type\":\"object\"},\"prices\":{\"additionalProperties\":false,\"properties\":{\"retail\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"allOf\":[{\"enum\":[\"CURRENCY\"],\"type\":\"string\"},{\"nullable\":true}]}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"},\"wholesale\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"}},\"readOnly\":true,\"required\":[\"wholesale\",\"retail\"],\"type\":\"object\"},\"product\":{\"allOf\":[{\"properties\":{\"description\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"operator\":{\"allOf\":[{\"properties\":{\"country\":{\"additionalProperties\":false,\"properties\":{\"iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"name\",\"iso_code\",\"regions\"],\"type\":\"object\"},\"id\":{\"description\":\"Operator identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"id\",\"name\",\"country\",\"regions\"],\"type\":\"object\"},{\"additionalProperties\":false}]},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"service\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"description\":\"Service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"subservice\":{\"nullable\":true,\"properties\":{\"id\":{\"description\":\"Sub-service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"}},\"required\":[\"id\",\"name\"],\"type\":\"object\"},\"tags\":{\"items\":{\"description\":\"Product tag.\",\"maxLength\":16,\"minLength\":4,\"pattern\":\"^[A-Z0-9_]+\",\"type\":\"string\"},\"maxItems\":1,\"minItems\":1,\"nullable\":true,\"type\":\"array\",\"uniqueItems\":true}},\"required\":[\"id\",\"name\",\"description\",\"tags\",\"service\",\"operator\",\"regions\"],\"type\":\"object\"},{\"properties\":{\"pin\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"terms\":{\"description\":\"Contains special conditions, as well as generic product Terms & Conditions. Formatted in [Markdown](https://en.wikipedia.org/wiki/Markdown).\",\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"usage_info\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"validity\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"quantity\":{\"description\":\"Quantity related to validity (e.g. `7` in `7 DAY`). A `null` value indicates validity is not known, while a value of `-1` indicates unlimited validity (i.e. no expiration).\",\"type\":\"integer\"},\"unit\":{\"enum\":[\"HOUR\",\"DAY\",\"WEEK\",\"MONTH\"],\"type\":\"string\"}},\"required\":[\"unit\",\"quantity\"],\"type\":\"object\"}},\"required\":[\"usage_info\",\"validity\",\"terms\"],\"type\":\"object\"},{\"nullable\":true}]},\"type\":{\"enum\":[\"FIXED_VALUE_RECHARGE\",\"RANGED_VALUE_RECHARGE\",\"FIXED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PAYMENT\"],\"type\":\"string\"}}},{\"readOnly\":true},{\"required\":[\"type\"]}]},\"product_id\":{\"allOf\":[{\"description\":\"Product identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}],\"writeOnly\":true},\"promotions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"type\":\"string\"},\"end_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"start_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"terms\":{\"nullable\":true,\"type\":\"string\"},\"title\":{\"type\":\"string\"}},\"required\":[\"id\",\"title\",\"description\",\"terms\",\"start_date\",\"end_date\"],\"type\":\"object\"},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"rates\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Exchange rate between the source amount and the destination amount.\",\"format\":\"double\",\"type\":\"number\"},\"retail\":{\"description\":\"Exchange rate between the retail price and the destination amount. A `null` value indicates retail prices are not configured, while a `-1` value indicates an infinite rate due to retail price being configured to a zero value.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"wholesale\":{\"description\":\"Exchange rate between the wholesale price and the destination amount.\",\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"wholesale\",\"retail\"],\"type\":\"object\"},{\"readOnly\":true}]},\"requested_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"sender\":{\"description\":\"Sender details for a transaction. This information is mostly optional and will only be required for products with sender information requirements as outlined in `required_sender_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `SOURCE_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"statement_identifier\":{\"description\":\"Qualifying statement details for a payment transaction. This information is mostly optional and will only be required for specific payment products with statement identifier requirements as outlined in `required_statement_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"due_date\":{\"format\":\"date\",\"type\":\"string\"},\"reference\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"properties\":{\"class\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"required\":[\"id\",\"message\"],\"type\":\"object\"},\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"type\":\"object\"}},\"required\":[\"external_id\",\"product_id\"],\"type\":\"object\"},{\"properties\":{\"callback_url\":{\"description\":\"Transaction status updates will be sent to this endpoint. See [Callbacks](#section/Overview/Callbacks) for more details.\",\"format\":\"uri\",\"type\":\"string\"}}}]},\"type\":\"array\"}}},\"description\":\"successful operation\",\"headers\":{\"X-Next-Page\":{\"description\":\"Next page number (if any).\",\"schema\":{\"type\":\"integer\"}},\"X-Page\":{\"description\":\"Current page number.\",\"schema\":{\"type\":\"integer\"}},\"X-Per-Page\":{\"description\":\"Number of records per page\",\"schema\":{\"type\":\"integer\"}},\"X-Prev-Page\":{\"description\":\"Previous page number (if any).\",\"schema\":{\"type\":\"integer\"}},\"X-Total\":{\"description\":\"Total number of records.\",\"schema\":{\"type\":\"integer\"}},\"X-Total-Pages\":{\"description\":\"Total number of pages.\",\"schema\":{\"type\":\"integer\"}}}},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"Transaction not found\"},\"default\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"default error response\"}},\"security\":[{\"BasicAuth\":[]}],\"securitySchemes\":{\"BasicAuth\":{\"description\":\"The Digital Value Services API requires requests to be authenticated through individualized API keys. You can view and manage your API keys in [DT Shop](https://dtshop.dtone.com/).\\n\\nYour API keys carry many privileges, so please keep them secure! Do not share your secret API keys in publicly-accessible areas such as [GitHub](https://github.com/), client-side code, and so forth.\\n\\nAuthentication to the API is performed via [HTTP Basic Auth](https://tools.ietf.org/html/rfc7235). Provide your API key as the basic auth username value and your API secret as your password.\\n\\nExcept when site-to-site VPN is set up, all API requests must be made over [HTTPS](http://en.wikipedia.org/wiki/HTTP_Secure) with TLS 1.2.\\n\\nOn a side note, we strongly recommend securing your applications against common security flaws by employing best practices such as the [OWASP Top 10](https://www.owasp.org/index.php/Category:OWASP_Top_Ten_Project).\\n\",\"scheme\":\"basic\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/transactions"
          segments: [
            {
              lit: "transactions"
            }
          ]
          select: {
            exist: [
              "country_iso_code"
              "credit_party_account_number"
              "credit_party_mobile_number"
              "external_id"
              "from_date"
              "operator_id"
              "page"
              "per_page"
              "product_type"
              "service_id"
              "status_id"
              "subservice_id"
              "to_date"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "transaction_id"
                orig: "transaction_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "GET /transactions/{transaction_id}"
            json: "{\"operationId\":\"getTransactionById\",\"parameters\":[{\"in\":\"path\",\"name\":\"transaction_id\",\"required\":true,\"schema\":{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"allOf\":[{\"properties\":{\"additional_identifier\":{\"description\":\"Additional details for a transaction. This information is mostly optional and will be required primarily for compliance reasons for products with additional information requirements as outlined in `required_additional_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"purchaser_id\":{\"description\":\"Anonymized ID related to the purchase for compliance reasons (e.g. terminal, POS, agent, end user, etc).\",\"pattern\":\"^[a-zA-Z0-9\\\\-]{8,36}$\",\"type\":\"string\"}},\"type\":\"object\"},\"adjusted_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"auto_confirm\":{\"default\":false,\"description\":\"Determines whether a transaction will be automatically confirmed upon creation or not. This is opted-out by default. Setting this field to `true` is recommended when transaction details, e.g. prices, are known as it removes the need to perform a separate API call to [confirm transactions](#operation/postTransactionConfirmAsync).\",\"type\":\"boolean\",\"writeOnly\":true},\"beneficiary\":{\"description\":\"Beneficiary details for a transaction. This information is mostly optional and will only be required for products with beneficiary information requirements as outlined in `required_beneficiary_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"benefits\":{\"items\":{\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Base benefit amount. A value of `-1` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"format\":\"double\",\"type\":\"number\"},\"promotion_bonus\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"total_excluding_tax\":{\"format\":\"double\",\"type\":\"number\"},\"total_including_tax\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"additionalProperties\":false,\"description\":\"Base product benefits. A `-1` value for `min` or `max` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"promotion_bonus\":{\"additionalProperties\":false,\"description\":\"Additional product benefits from applicable promotions.\",\"properties\":{\"max\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"min\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_excluding_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions before taxes.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_including_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions after taxes. This field indicates the end benefits received by the end user.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"}]},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"calculation_mode\":{\"allOf\":[{\"enum\":[\"SOURCE_AMOUNT\",\"DESTINATION_AMOUNT\"],\"type\":\"string\"},{\"nullable\":true},{\"writeOnly\":true},{\"description\":\"Required when product type is either `RANGED_VALUE_RECHARGE`, `RANGED_VALUE_PIN_PURCHASE`, or `RANGED_VALUE_PAYMENT`\"}]},\"confirmation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"confirmation_expiration_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"creation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"credit_party_identifier\":{\"description\":\"Receiving account details for a transaction. This information will be required for the majority of products with credit party inofrmation requirements outlined in `required_credit_party_identifier_fields`, but will be optional for certain products without any upfront recipient, e.g. Gift Cards.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"debit_party_identifier\":{\"description\":\"Sending account details for a transaction. This information is mostly optional and will only be required for products with debit party information requirements as outlined in `required_debit_party_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"destination\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `DESTINATION_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"external_id\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"maxLength\":40},{\"description\":\"Unique identifier for the transaction in your system.\"}]},\"id\":{\"allOf\":[{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}],\"readOnly\":true},\"metadata\":{\"allOf\":[{\"discriminator\":{\"mapping\":{\"ESIM\":\"#/components/schemas/transaction_metadata_esim\"},\"propertyName\":\"type\"},\"oneOf\":[{\"additionalProperties\":false,\"description\":\"eSIM transaction metadata.\",\"properties\":{\"activation_type\":{\"description\":\"Type of activation performed.\",\"enum\":[\"DATA_PLAN\",\"TOP_UP\"],\"type\":\"string\"},\"balance\":{\"additionalProperties\":false,\"description\":\"Balance information for the activated eSIM data package.\",\"properties\":{\"country_set\":{\"description\":\"Country set code (e.g., WWW for worldwide).\",\"type\":\"string\"},\"extended_data_policy\":{\"additionalProperties\":false,\"description\":\"Enriched with runtime state for an activated pack. Always returned. For STANDARD plans, only the type field will be returned.\",\"properties\":{\"fixed_time\":{\"description\":\"Time of day (HH:MM in UTC) when high-speed volume resets. Only present when reset_type is FIXED_TIME. Typically midnight (\\\"00:00\\\") but may vary due to time zone differences (e.g., \\\"08:00\\\").\",\"example\":\"00:00\",\"nullable\":true,\"pattern\":\"^\\\\d{2}:\\\\d{2}$\",\"type\":\"string\"},\"interval\":{\"description\":\"Interval duration for high-speed volume reset. Only present when reset_type is TIME_INTERVAL. For example, \\\"24h\\\" means the high-speed volume resets every 24 hours from activation.\",\"example\":\"24h\",\"nullable\":true,\"type\":\"string\"},\"reset_type\":{\"allOf\":[{\"description\":\"Method for resetting the high-speed data volume. Determines whether the interval or fixed_time field is returned. TIME_INTERVAL: high-speed volume resets on a recurring interval from activation (see interval field). FIXED_TIME: high-speed volume resets at a specific time of day (see fixed_time field). NONE: high-speed volume does not reset.\",\"enum\":[\"TIME_INTERVAL\",\"FIXED_TIME\",\"NONE\"],\"nullable\":true,\"type\":\"string\"},{\"nullable\":true}]},\"throttle_speed\":{\"description\":\"Speed to throttle to after high-speed volume is used up.\",\"example\":\"128 KB/s\",\"nullable\":true,\"type\":\"string\"},\"total_high_speed_volume\":{\"additionalProperties\":false,\"description\":\"Total high-speed data volume before throttling. Only populated when extended_data_policy type is UNLIMITED.\",\"nullable\":true,\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"type\":{\"description\":\"Package type.\",\"enum\":[\"STANDARD\",\"UNLIMITED\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"size\":{\"additionalProperties\":false,\"description\":\"Total data size of the package.\",\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"validity\":{\"additionalProperties\":false,\"description\":\"Remaining validity of the package.\",\"properties\":{\"quantity\":{\"description\":\"Original validity size of the activated item.\",\"example\":365,\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of validity period.\",\"enum\":[\"YEAR\",\"MONTH\",\"WEEK\",\"DAY\",\"HOUR\",\"MINUTE\",\"SECOND\"],\"type\":\"string\"}},\"required\":[\"quantity\",\"unit\"],\"type\":\"object\"}},\"required\":[\"size\",\"validity\",\"country_set\",\"extended_data_policy\"],\"type\":\"object\"},\"profile\":{\"allOf\":[{\"additionalProperties\":false,\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\",\"nullable\":true,\"properties\":{\"activation_code\":{\"description\":\"QR code content for eSIM installation.\",\"type\":\"string\"},\"android_universal_link\":{\"description\":\"Universal link for eSIM installation on Android devices.\",\"format\":\"uri\",\"type\":\"string\"},\"apple_universal_link\":{\"description\":\"Universal link for eSIM installation on Apple devices.\",\"format\":\"uri\",\"type\":\"string\"},\"iccid\":{\"description\":\"Integrated Circuit Card Identifier.\",\"type\":\"string\"},\"installation_url\":{\"description\":\"Generic installation URL for the eSIM.\",\"format\":\"uri\",\"type\":\"string\"}},\"required\":[\"iccid\",\"activation_code\",\"apple_universal_link\",\"android_universal_link\",\"installation_url\"],\"type\":\"object\"}],\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\"},\"type\":{\"enum\":[\"ESIM\"],\"type\":\"string\"}},\"required\":[\"type\",\"activation_type\",\"balance\"],\"type\":\"object\"}]}],\"description\":\"Optional metadata related to the transaction. This can include any additional information that may be relevant\\nfor the transaction but is not covered by the other fields.\\nThe structure of this object can vary depending on the product type or service and specific use case.\\nFor example, for eSIM products, this field may contain additional details about the eSIM activation, balance and profile.\\n\",\"type\":\"object\"},\"operator_reference\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"readOnly\":true,\"type\":\"string\"},\"pin\":{\"nullable\":true,\"properties\":{\"code\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"serial\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"required\":[\"code\",\"serial\"],\"type\":\"object\"},\"prices\":{\"additionalProperties\":false,\"properties\":{\"retail\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"allOf\":[{\"enum\":[\"CURRENCY\"],\"type\":\"string\"},{\"nullable\":true}]}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"},\"wholesale\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"}},\"readOnly\":true,\"required\":[\"wholesale\",\"retail\"],\"type\":\"object\"},\"product\":{\"allOf\":[{\"properties\":{\"description\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"operator\":{\"allOf\":[{\"properties\":{\"country\":{\"additionalProperties\":false,\"properties\":{\"iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"name\",\"iso_code\",\"regions\"],\"type\":\"object\"},\"id\":{\"description\":\"Operator identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"id\",\"name\",\"country\",\"regions\"],\"type\":\"object\"},{\"additionalProperties\":false}]},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"service\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"description\":\"Service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"subservice\":{\"nullable\":true,\"properties\":{\"id\":{\"description\":\"Sub-service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"}},\"required\":[\"id\",\"name\"],\"type\":\"object\"},\"tags\":{\"items\":{\"description\":\"Product tag.\",\"maxLength\":16,\"minLength\":4,\"pattern\":\"^[A-Z0-9_]+\",\"type\":\"string\"},\"maxItems\":1,\"minItems\":1,\"nullable\":true,\"type\":\"array\",\"uniqueItems\":true}},\"required\":[\"id\",\"name\",\"description\",\"tags\",\"service\",\"operator\",\"regions\"],\"type\":\"object\"},{\"properties\":{\"pin\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"terms\":{\"description\":\"Contains special conditions, as well as generic product Terms & Conditions. Formatted in [Markdown](https://en.wikipedia.org/wiki/Markdown).\",\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"usage_info\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"validity\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"quantity\":{\"description\":\"Quantity related to validity (e.g. `7` in `7 DAY`). A `null` value indicates validity is not known, while a value of `-1` indicates unlimited validity (i.e. no expiration).\",\"type\":\"integer\"},\"unit\":{\"enum\":[\"HOUR\",\"DAY\",\"WEEK\",\"MONTH\"],\"type\":\"string\"}},\"required\":[\"unit\",\"quantity\"],\"type\":\"object\"}},\"required\":[\"usage_info\",\"validity\",\"terms\"],\"type\":\"object\"},{\"nullable\":true}]},\"type\":{\"enum\":[\"FIXED_VALUE_RECHARGE\",\"RANGED_VALUE_RECHARGE\",\"FIXED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PAYMENT\"],\"type\":\"string\"}}},{\"readOnly\":true},{\"required\":[\"type\"]}]},\"product_id\":{\"allOf\":[{\"description\":\"Product identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}],\"writeOnly\":true},\"promotions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"type\":\"string\"},\"end_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"start_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"terms\":{\"nullable\":true,\"type\":\"string\"},\"title\":{\"type\":\"string\"}},\"required\":[\"id\",\"title\",\"description\",\"terms\",\"start_date\",\"end_date\"],\"type\":\"object\"},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"rates\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Exchange rate between the source amount and the destination amount.\",\"format\":\"double\",\"type\":\"number\"},\"retail\":{\"description\":\"Exchange rate between the retail price and the destination amount. A `null` value indicates retail prices are not configured, while a `-1` value indicates an infinite rate due to retail price being configured to a zero value.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"wholesale\":{\"description\":\"Exchange rate between the wholesale price and the destination amount.\",\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"wholesale\",\"retail\"],\"type\":\"object\"},{\"readOnly\":true}]},\"requested_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"sender\":{\"description\":\"Sender details for a transaction. This information is mostly optional and will only be required for products with sender information requirements as outlined in `required_sender_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `SOURCE_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"statement_identifier\":{\"description\":\"Qualifying statement details for a payment transaction. This information is mostly optional and will only be required for specific payment products with statement identifier requirements as outlined in `required_statement_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"due_date\":{\"format\":\"date\",\"type\":\"string\"},\"reference\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"properties\":{\"class\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"required\":[\"id\",\"message\"],\"type\":\"object\"},\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"type\":\"object\"}},\"required\":[\"external_id\",\"product_id\"],\"type\":\"object\"},{\"properties\":{\"callback_url\":{\"description\":\"Transaction status updates will be sent to this endpoint. See [Callbacks](#section/Overview/Callbacks) for more details.\",\"format\":\"uri\",\"type\":\"string\"}}}]}}},\"description\":\"successful operation\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"Transaction not found\"},\"default\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"default error response\"}},\"security\":[{\"BasicAuth\":[]}],\"securitySchemes\":{\"BasicAuth\":{\"description\":\"The Digital Value Services API requires requests to be authenticated through individualized API keys. You can view and manage your API keys in [DT Shop](https://dtshop.dtone.com/).\\n\\nYour API keys carry many privileges, so please keep them secure! Do not share your secret API keys in publicly-accessible areas such as [GitHub](https://github.com/), client-side code, and so forth.\\n\\nAuthentication to the API is performed via [HTTP Basic Auth](https://tools.ietf.org/html/rfc7235). Provide your API key as the basic auth username value and your API secret as your password.\\n\\nExcept when site-to-site VPN is set up, all API requests must be made over [HTTPS](http://en.wikipedia.org/wiki/HTTP_Secure) with TLS 1.2.\\n\\nOn a side note, we strongly recommend securing your applications against common security flaws by employing best practices such as the [OWASP Top 10](https://www.owasp.org/index.php/Category:OWASP_Top_Ten_Project).\\n\",\"scheme\":\"basic\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/transactions/{transaction_id}"
          segments: [
            {
              lit: "transactions"
            }
            {
              var: "transaction_id"
            }
          ]
          select: {
            exist: [
              "transaction_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "transaction_id"
                orig: "transaction_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "POST /transactions/{transaction_id}/cancel"
            json: "{\"operationId\":\"postTransactionCancel\",\"parameters\":[{\"in\":\"path\",\"name\":\"transaction_id\",\"required\":true,\"schema\":{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"202\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"additional_identifier\":{\"description\":\"Additional details for a transaction. This information is mostly optional and will be required primarily for compliance reasons for products with additional information requirements as outlined in `required_additional_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"purchaser_id\":{\"description\":\"Anonymized ID related to the purchase for compliance reasons (e.g. terminal, POS, agent, end user, etc).\",\"pattern\":\"^[a-zA-Z0-9\\\\-]{8,36}$\",\"type\":\"string\"}},\"type\":\"object\"},\"adjusted_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"auto_confirm\":{\"default\":false,\"description\":\"Determines whether a transaction will be automatically confirmed upon creation or not. This is opted-out by default. Setting this field to `true` is recommended when transaction details, e.g. prices, are known as it removes the need to perform a separate API call to [confirm transactions](#operation/postTransactionConfirmAsync).\",\"type\":\"boolean\",\"writeOnly\":true},\"beneficiary\":{\"description\":\"Beneficiary details for a transaction. This information is mostly optional and will only be required for products with beneficiary information requirements as outlined in `required_beneficiary_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"benefits\":{\"items\":{\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Base benefit amount. A value of `-1` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"format\":\"double\",\"type\":\"number\"},\"promotion_bonus\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"total_excluding_tax\":{\"format\":\"double\",\"type\":\"number\"},\"total_including_tax\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"additionalProperties\":false,\"description\":\"Base product benefits. A `-1` value for `min` or `max` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"promotion_bonus\":{\"additionalProperties\":false,\"description\":\"Additional product benefits from applicable promotions.\",\"properties\":{\"max\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"min\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_excluding_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions before taxes.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_including_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions after taxes. This field indicates the end benefits received by the end user.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"}]},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"calculation_mode\":{\"allOf\":[{\"enum\":[\"SOURCE_AMOUNT\",\"DESTINATION_AMOUNT\"],\"type\":\"string\"},{\"nullable\":true},{\"writeOnly\":true},{\"description\":\"Required when product type is either `RANGED_VALUE_RECHARGE`, `RANGED_VALUE_PIN_PURCHASE`, or `RANGED_VALUE_PAYMENT`\"}]},\"confirmation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"confirmation_expiration_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"creation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"credit_party_identifier\":{\"description\":\"Receiving account details for a transaction. This information will be required for the majority of products with credit party inofrmation requirements outlined in `required_credit_party_identifier_fields`, but will be optional for certain products without any upfront recipient, e.g. Gift Cards.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"debit_party_identifier\":{\"description\":\"Sending account details for a transaction. This information is mostly optional and will only be required for products with debit party information requirements as outlined in `required_debit_party_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"destination\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `DESTINATION_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"external_id\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"maxLength\":40},{\"description\":\"Unique identifier for the transaction in your system.\"}]},\"id\":{\"allOf\":[{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}],\"readOnly\":true},\"metadata\":{\"allOf\":[{\"discriminator\":{\"mapping\":{\"ESIM\":\"#/components/schemas/transaction_metadata_esim\"},\"propertyName\":\"type\"},\"oneOf\":[{\"additionalProperties\":false,\"description\":\"eSIM transaction metadata.\",\"properties\":{\"activation_type\":{\"description\":\"Type of activation performed.\",\"enum\":[\"DATA_PLAN\",\"TOP_UP\"],\"type\":\"string\"},\"balance\":{\"additionalProperties\":false,\"description\":\"Balance information for the activated eSIM data package.\",\"properties\":{\"country_set\":{\"description\":\"Country set code (e.g., WWW for worldwide).\",\"type\":\"string\"},\"extended_data_policy\":{\"additionalProperties\":false,\"description\":\"Enriched with runtime state for an activated pack. Always returned. For STANDARD plans, only the type field will be returned.\",\"properties\":{\"fixed_time\":{\"description\":\"Time of day (HH:MM in UTC) when high-speed volume resets. Only present when reset_type is FIXED_TIME. Typically midnight (\\\"00:00\\\") but may vary due to time zone differences (e.g., \\\"08:00\\\").\",\"example\":\"00:00\",\"nullable\":true,\"pattern\":\"^\\\\d{2}:\\\\d{2}$\",\"type\":\"string\"},\"interval\":{\"description\":\"Interval duration for high-speed volume reset. Only present when reset_type is TIME_INTERVAL. For example, \\\"24h\\\" means the high-speed volume resets every 24 hours from activation.\",\"example\":\"24h\",\"nullable\":true,\"type\":\"string\"},\"reset_type\":{\"allOf\":[{\"description\":\"Method for resetting the high-speed data volume. Determines whether the interval or fixed_time field is returned. TIME_INTERVAL: high-speed volume resets on a recurring interval from activation (see interval field). FIXED_TIME: high-speed volume resets at a specific time of day (see fixed_time field). NONE: high-speed volume does not reset.\",\"enum\":[\"TIME_INTERVAL\",\"FIXED_TIME\",\"NONE\"],\"nullable\":true,\"type\":\"string\"},{\"nullable\":true}]},\"throttle_speed\":{\"description\":\"Speed to throttle to after high-speed volume is used up.\",\"example\":\"128 KB/s\",\"nullable\":true,\"type\":\"string\"},\"total_high_speed_volume\":{\"additionalProperties\":false,\"description\":\"Total high-speed data volume before throttling. Only populated when extended_data_policy type is UNLIMITED.\",\"nullable\":true,\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"type\":{\"description\":\"Package type.\",\"enum\":[\"STANDARD\",\"UNLIMITED\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"size\":{\"additionalProperties\":false,\"description\":\"Total data size of the package.\",\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"validity\":{\"additionalProperties\":false,\"description\":\"Remaining validity of the package.\",\"properties\":{\"quantity\":{\"description\":\"Original validity size of the activated item.\",\"example\":365,\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of validity period.\",\"enum\":[\"YEAR\",\"MONTH\",\"WEEK\",\"DAY\",\"HOUR\",\"MINUTE\",\"SECOND\"],\"type\":\"string\"}},\"required\":[\"quantity\",\"unit\"],\"type\":\"object\"}},\"required\":[\"size\",\"validity\",\"country_set\",\"extended_data_policy\"],\"type\":\"object\"},\"profile\":{\"allOf\":[{\"additionalProperties\":false,\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\",\"nullable\":true,\"properties\":{\"activation_code\":{\"description\":\"QR code content for eSIM installation.\",\"type\":\"string\"},\"android_universal_link\":{\"description\":\"Universal link for eSIM installation on Android devices.\",\"format\":\"uri\",\"type\":\"string\"},\"apple_universal_link\":{\"description\":\"Universal link for eSIM installation on Apple devices.\",\"format\":\"uri\",\"type\":\"string\"},\"iccid\":{\"description\":\"Integrated Circuit Card Identifier.\",\"type\":\"string\"},\"installation_url\":{\"description\":\"Generic installation URL for the eSIM.\",\"format\":\"uri\",\"type\":\"string\"}},\"required\":[\"iccid\",\"activation_code\",\"apple_universal_link\",\"android_universal_link\",\"installation_url\"],\"type\":\"object\"}],\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\"},\"type\":{\"enum\":[\"ESIM\"],\"type\":\"string\"}},\"required\":[\"type\",\"activation_type\",\"balance\"],\"type\":\"object\"}]}],\"description\":\"Optional metadata related to the transaction. This can include any additional information that may be relevant\\nfor the transaction but is not covered by the other fields.\\nThe structure of this object can vary depending on the product type or service and specific use case.\\nFor example, for eSIM products, this field may contain additional details about the eSIM activation, balance and profile.\\n\",\"type\":\"object\"},\"operator_reference\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"readOnly\":true,\"type\":\"string\"},\"pin\":{\"nullable\":true,\"properties\":{\"code\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"serial\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"required\":[\"code\",\"serial\"],\"type\":\"object\"},\"prices\":{\"additionalProperties\":false,\"properties\":{\"retail\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"allOf\":[{\"enum\":[\"CURRENCY\"],\"type\":\"string\"},{\"nullable\":true}]}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"},\"wholesale\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"}},\"readOnly\":true,\"required\":[\"wholesale\",\"retail\"],\"type\":\"object\"},\"product\":{\"allOf\":[{\"properties\":{\"description\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"operator\":{\"allOf\":[{\"properties\":{\"country\":{\"additionalProperties\":false,\"properties\":{\"iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"name\",\"iso_code\",\"regions\"],\"type\":\"object\"},\"id\":{\"description\":\"Operator identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"id\",\"name\",\"country\",\"regions\"],\"type\":\"object\"},{\"additionalProperties\":false}]},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"service\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"description\":\"Service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"subservice\":{\"nullable\":true,\"properties\":{\"id\":{\"description\":\"Sub-service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"}},\"required\":[\"id\",\"name\"],\"type\":\"object\"},\"tags\":{\"items\":{\"description\":\"Product tag.\",\"maxLength\":16,\"minLength\":4,\"pattern\":\"^[A-Z0-9_]+\",\"type\":\"string\"},\"maxItems\":1,\"minItems\":1,\"nullable\":true,\"type\":\"array\",\"uniqueItems\":true}},\"required\":[\"id\",\"name\",\"description\",\"tags\",\"service\",\"operator\",\"regions\"],\"type\":\"object\"},{\"properties\":{\"pin\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"terms\":{\"description\":\"Contains special conditions, as well as generic product Terms & Conditions. Formatted in [Markdown](https://en.wikipedia.org/wiki/Markdown).\",\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"usage_info\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"validity\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"quantity\":{\"description\":\"Quantity related to validity (e.g. `7` in `7 DAY`). A `null` value indicates validity is not known, while a value of `-1` indicates unlimited validity (i.e. no expiration).\",\"type\":\"integer\"},\"unit\":{\"enum\":[\"HOUR\",\"DAY\",\"WEEK\",\"MONTH\"],\"type\":\"string\"}},\"required\":[\"unit\",\"quantity\"],\"type\":\"object\"}},\"required\":[\"usage_info\",\"validity\",\"terms\"],\"type\":\"object\"},{\"nullable\":true}]},\"type\":{\"enum\":[\"FIXED_VALUE_RECHARGE\",\"RANGED_VALUE_RECHARGE\",\"FIXED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PAYMENT\"],\"type\":\"string\"}}},{\"readOnly\":true},{\"required\":[\"type\"]}]},\"product_id\":{\"allOf\":[{\"description\":\"Product identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}],\"writeOnly\":true},\"promotions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"type\":\"string\"},\"end_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"start_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"terms\":{\"nullable\":true,\"type\":\"string\"},\"title\":{\"type\":\"string\"}},\"required\":[\"id\",\"title\",\"description\",\"terms\",\"start_date\",\"end_date\"],\"type\":\"object\"},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"rates\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Exchange rate between the source amount and the destination amount.\",\"format\":\"double\",\"type\":\"number\"},\"retail\":{\"description\":\"Exchange rate between the retail price and the destination amount. A `null` value indicates retail prices are not configured, while a `-1` value indicates an infinite rate due to retail price being configured to a zero value.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"wholesale\":{\"description\":\"Exchange rate between the wholesale price and the destination amount.\",\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"wholesale\",\"retail\"],\"type\":\"object\"},{\"readOnly\":true}]},\"requested_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"sender\":{\"description\":\"Sender details for a transaction. This information is mostly optional and will only be required for products with sender information requirements as outlined in `required_sender_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `SOURCE_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"statement_identifier\":{\"description\":\"Qualifying statement details for a payment transaction. This information is mostly optional and will only be required for specific payment products with statement identifier requirements as outlined in `required_statement_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"due_date\":{\"format\":\"date\",\"type\":\"string\"},\"reference\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"properties\":{\"class\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"required\":[\"id\",\"message\"],\"type\":\"object\"},\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"type\":\"object\"}},\"required\":[\"external_id\",\"product_id\"],\"type\":\"object\"}}},\"description\":\"Transaction cancelled\"},\"default\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"default error response\"}},\"security\":[{\"BasicAuth\":[]}],\"securitySchemes\":{\"BasicAuth\":{\"description\":\"The Digital Value Services API requires requests to be authenticated through individualized API keys. You can view and manage your API keys in [DT Shop](https://dtshop.dtone.com/).\\n\\nYour API keys carry many privileges, so please keep them secure! Do not share your secret API keys in publicly-accessible areas such as [GitHub](https://github.com/), client-side code, and so forth.\\n\\nAuthentication to the API is performed via [HTTP Basic Auth](https://tools.ietf.org/html/rfc7235). Provide your API key as the basic auth username value and your API secret as your password.\\n\\nExcept when site-to-site VPN is set up, all API requests must be made over [HTTPS](http://en.wikipedia.org/wiki/HTTP_Secure) with TLS 1.2.\\n\\nOn a side note, we strongly recommend securing your applications against common security flaws by employing best practices such as the [OWASP Top 10](https://www.owasp.org/index.php/Category:OWASP_Top_Ten_Project).\\n\",\"scheme\":\"basic\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/transactions/{transaction_id}/cancel"
          segments: [
            {
              lit: "transactions"
            }
            {
              var: "transaction_id"
            }
            {
              lit: "cancel"
            }
          ]
          select: {
            "$action": "cancel"
            exist: [
              "transaction_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "transaction_id"
                orig: "transaction_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "POST /async/transactions/{transaction_id}/confirm"
            json: "{\"operationId\":\"postTransactionConfirmAsync\",\"parameters\":[{\"in\":\"path\",\"name\":\"transaction_id\",\"required\":true,\"schema\":{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"202\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"additional_identifier\":{\"description\":\"Additional details for a transaction. This information is mostly optional and will be required primarily for compliance reasons for products with additional information requirements as outlined in `required_additional_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"purchaser_id\":{\"description\":\"Anonymized ID related to the purchase for compliance reasons (e.g. terminal, POS, agent, end user, etc).\",\"pattern\":\"^[a-zA-Z0-9\\\\-]{8,36}$\",\"type\":\"string\"}},\"type\":\"object\"},\"adjusted_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"auto_confirm\":{\"default\":false,\"description\":\"Determines whether a transaction will be automatically confirmed upon creation or not. This is opted-out by default. Setting this field to `true` is recommended when transaction details, e.g. prices, are known as it removes the need to perform a separate API call to [confirm transactions](#operation/postTransactionConfirmAsync).\",\"type\":\"boolean\",\"writeOnly\":true},\"beneficiary\":{\"description\":\"Beneficiary details for a transaction. This information is mostly optional and will only be required for products with beneficiary information requirements as outlined in `required_beneficiary_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"benefits\":{\"items\":{\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Base benefit amount. A value of `-1` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"format\":\"double\",\"type\":\"number\"},\"promotion_bonus\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"total_excluding_tax\":{\"format\":\"double\",\"type\":\"number\"},\"total_including_tax\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"additionalProperties\":false,\"description\":\"Base product benefits. A `-1` value for `min` or `max` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"promotion_bonus\":{\"additionalProperties\":false,\"description\":\"Additional product benefits from applicable promotions.\",\"properties\":{\"max\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"min\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_excluding_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions before taxes.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_including_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions after taxes. This field indicates the end benefits received by the end user.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"}]},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"calculation_mode\":{\"allOf\":[{\"enum\":[\"SOURCE_AMOUNT\",\"DESTINATION_AMOUNT\"],\"type\":\"string\"},{\"nullable\":true},{\"writeOnly\":true},{\"description\":\"Required when product type is either `RANGED_VALUE_RECHARGE`, `RANGED_VALUE_PIN_PURCHASE`, or `RANGED_VALUE_PAYMENT`\"}]},\"confirmation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"confirmation_expiration_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"creation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"credit_party_identifier\":{\"description\":\"Receiving account details for a transaction. This information will be required for the majority of products with credit party inofrmation requirements outlined in `required_credit_party_identifier_fields`, but will be optional for certain products without any upfront recipient, e.g. Gift Cards.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"debit_party_identifier\":{\"description\":\"Sending account details for a transaction. This information is mostly optional and will only be required for products with debit party information requirements as outlined in `required_debit_party_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"destination\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `DESTINATION_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"external_id\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"maxLength\":40},{\"description\":\"Unique identifier for the transaction in your system.\"}]},\"id\":{\"allOf\":[{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}],\"readOnly\":true},\"metadata\":{\"allOf\":[{\"discriminator\":{\"mapping\":{\"ESIM\":\"#/components/schemas/transaction_metadata_esim\"},\"propertyName\":\"type\"},\"oneOf\":[{\"additionalProperties\":false,\"description\":\"eSIM transaction metadata.\",\"properties\":{\"activation_type\":{\"description\":\"Type of activation performed.\",\"enum\":[\"DATA_PLAN\",\"TOP_UP\"],\"type\":\"string\"},\"balance\":{\"additionalProperties\":false,\"description\":\"Balance information for the activated eSIM data package.\",\"properties\":{\"country_set\":{\"description\":\"Country set code (e.g., WWW for worldwide).\",\"type\":\"string\"},\"extended_data_policy\":{\"additionalProperties\":false,\"description\":\"Enriched with runtime state for an activated pack. Always returned. For STANDARD plans, only the type field will be returned.\",\"properties\":{\"fixed_time\":{\"description\":\"Time of day (HH:MM in UTC) when high-speed volume resets. Only present when reset_type is FIXED_TIME. Typically midnight (\\\"00:00\\\") but may vary due to time zone differences (e.g., \\\"08:00\\\").\",\"example\":\"00:00\",\"nullable\":true,\"pattern\":\"^\\\\d{2}:\\\\d{2}$\",\"type\":\"string\"},\"interval\":{\"description\":\"Interval duration for high-speed volume reset. Only present when reset_type is TIME_INTERVAL. For example, \\\"24h\\\" means the high-speed volume resets every 24 hours from activation.\",\"example\":\"24h\",\"nullable\":true,\"type\":\"string\"},\"reset_type\":{\"allOf\":[{\"description\":\"Method for resetting the high-speed data volume. Determines whether the interval or fixed_time field is returned. TIME_INTERVAL: high-speed volume resets on a recurring interval from activation (see interval field). FIXED_TIME: high-speed volume resets at a specific time of day (see fixed_time field). NONE: high-speed volume does not reset.\",\"enum\":[\"TIME_INTERVAL\",\"FIXED_TIME\",\"NONE\"],\"nullable\":true,\"type\":\"string\"},{\"nullable\":true}]},\"throttle_speed\":{\"description\":\"Speed to throttle to after high-speed volume is used up.\",\"example\":\"128 KB/s\",\"nullable\":true,\"type\":\"string\"},\"total_high_speed_volume\":{\"additionalProperties\":false,\"description\":\"Total high-speed data volume before throttling. Only populated when extended_data_policy type is UNLIMITED.\",\"nullable\":true,\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"type\":{\"description\":\"Package type.\",\"enum\":[\"STANDARD\",\"UNLIMITED\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"size\":{\"additionalProperties\":false,\"description\":\"Total data size of the package.\",\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"validity\":{\"additionalProperties\":false,\"description\":\"Remaining validity of the package.\",\"properties\":{\"quantity\":{\"description\":\"Original validity size of the activated item.\",\"example\":365,\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of validity period.\",\"enum\":[\"YEAR\",\"MONTH\",\"WEEK\",\"DAY\",\"HOUR\",\"MINUTE\",\"SECOND\"],\"type\":\"string\"}},\"required\":[\"quantity\",\"unit\"],\"type\":\"object\"}},\"required\":[\"size\",\"validity\",\"country_set\",\"extended_data_policy\"],\"type\":\"object\"},\"profile\":{\"allOf\":[{\"additionalProperties\":false,\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\",\"nullable\":true,\"properties\":{\"activation_code\":{\"description\":\"QR code content for eSIM installation.\",\"type\":\"string\"},\"android_universal_link\":{\"description\":\"Universal link for eSIM installation on Android devices.\",\"format\":\"uri\",\"type\":\"string\"},\"apple_universal_link\":{\"description\":\"Universal link for eSIM installation on Apple devices.\",\"format\":\"uri\",\"type\":\"string\"},\"iccid\":{\"description\":\"Integrated Circuit Card Identifier.\",\"type\":\"string\"},\"installation_url\":{\"description\":\"Generic installation URL for the eSIM.\",\"format\":\"uri\",\"type\":\"string\"}},\"required\":[\"iccid\",\"activation_code\",\"apple_universal_link\",\"android_universal_link\",\"installation_url\"],\"type\":\"object\"}],\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\"},\"type\":{\"enum\":[\"ESIM\"],\"type\":\"string\"}},\"required\":[\"type\",\"activation_type\",\"balance\"],\"type\":\"object\"}]}],\"description\":\"Optional metadata related to the transaction. This can include any additional information that may be relevant\\nfor the transaction but is not covered by the other fields.\\nThe structure of this object can vary depending on the product type or service and specific use case.\\nFor example, for eSIM products, this field may contain additional details about the eSIM activation, balance and profile.\\n\",\"type\":\"object\"},\"operator_reference\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"readOnly\":true,\"type\":\"string\"},\"pin\":{\"nullable\":true,\"properties\":{\"code\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"serial\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"required\":[\"code\",\"serial\"],\"type\":\"object\"},\"prices\":{\"additionalProperties\":false,\"properties\":{\"retail\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"allOf\":[{\"enum\":[\"CURRENCY\"],\"type\":\"string\"},{\"nullable\":true}]}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"},\"wholesale\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"}},\"readOnly\":true,\"required\":[\"wholesale\",\"retail\"],\"type\":\"object\"},\"product\":{\"allOf\":[{\"properties\":{\"description\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"operator\":{\"allOf\":[{\"properties\":{\"country\":{\"additionalProperties\":false,\"properties\":{\"iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"name\",\"iso_code\",\"regions\"],\"type\":\"object\"},\"id\":{\"description\":\"Operator identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"id\",\"name\",\"country\",\"regions\"],\"type\":\"object\"},{\"additionalProperties\":false}]},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"service\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"description\":\"Service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"subservice\":{\"nullable\":true,\"properties\":{\"id\":{\"description\":\"Sub-service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"}},\"required\":[\"id\",\"name\"],\"type\":\"object\"},\"tags\":{\"items\":{\"description\":\"Product tag.\",\"maxLength\":16,\"minLength\":4,\"pattern\":\"^[A-Z0-9_]+\",\"type\":\"string\"},\"maxItems\":1,\"minItems\":1,\"nullable\":true,\"type\":\"array\",\"uniqueItems\":true}},\"required\":[\"id\",\"name\",\"description\",\"tags\",\"service\",\"operator\",\"regions\"],\"type\":\"object\"},{\"properties\":{\"pin\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"terms\":{\"description\":\"Contains special conditions, as well as generic product Terms & Conditions. Formatted in [Markdown](https://en.wikipedia.org/wiki/Markdown).\",\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"usage_info\":{\"items\":{\"type\":\"string\"},\"nullable\":true,\"type\":\"array\"},\"validity\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"quantity\":{\"description\":\"Quantity related to validity (e.g. `7` in `7 DAY`). A `null` value indicates validity is not known, while a value of `-1` indicates unlimited validity (i.e. no expiration).\",\"type\":\"integer\"},\"unit\":{\"enum\":[\"HOUR\",\"DAY\",\"WEEK\",\"MONTH\"],\"type\":\"string\"}},\"required\":[\"unit\",\"quantity\"],\"type\":\"object\"}},\"required\":[\"usage_info\",\"validity\",\"terms\"],\"type\":\"object\"},{\"nullable\":true}]},\"type\":{\"enum\":[\"FIXED_VALUE_RECHARGE\",\"RANGED_VALUE_RECHARGE\",\"FIXED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PAYMENT\"],\"type\":\"string\"}}},{\"readOnly\":true},{\"required\":[\"type\"]}]},\"product_id\":{\"allOf\":[{\"description\":\"Product identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}],\"writeOnly\":true},\"promotions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"type\":\"string\"},\"end_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"start_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"terms\":{\"nullable\":true,\"type\":\"string\"},\"title\":{\"type\":\"string\"}},\"required\":[\"id\",\"title\",\"description\",\"terms\",\"start_date\",\"end_date\"],\"type\":\"object\"},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"rates\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Exchange rate between the source amount and the destination amount.\",\"format\":\"double\",\"type\":\"number\"},\"retail\":{\"description\":\"Exchange rate between the retail price and the destination amount. A `null` value indicates retail prices are not configured, while a `-1` value indicates an infinite rate due to retail price being configured to a zero value.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"wholesale\":{\"description\":\"Exchange rate between the wholesale price and the destination amount.\",\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"wholesale\",\"retail\"],\"type\":\"object\"},{\"readOnly\":true}]},\"requested_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"sender\":{\"description\":\"Sender details for a transaction. This information is mostly optional and will only be required for products with sender information requirements as outlined in `required_sender_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `SOURCE_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"statement_identifier\":{\"description\":\"Qualifying statement details for a payment transaction. This information is mostly optional and will only be required for specific payment products with statement identifier requirements as outlined in `required_statement_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"due_date\":{\"format\":\"date\",\"type\":\"string\"},\"reference\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"properties\":{\"class\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"required\":[\"id\",\"message\"],\"type\":\"object\"},\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"type\":\"object\"}},\"required\":[\"external_id\",\"product_id\"],\"type\":\"object\"}}},\"description\":\"Transaction confirmed\"},\"default\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"type\":\"integer\"},\"message\":{\"type\":\"string\"}},\"required\":[\"code\",\"message\"],\"type\":\"object\"},\"type\":\"array\"}},\"required\":[\"errors\"],\"type\":\"object\"}}},\"description\":\"default error response\"}},\"security\":[{\"BasicAuth\":[]}],\"securitySchemes\":{\"BasicAuth\":{\"description\":\"The Digital Value Services API requires requests to be authenticated through individualized API keys. You can view and manage your API keys in [DT Shop](https://dtshop.dtone.com/).\\n\\nYour API keys carry many privileges, so please keep them secure! Do not share your secret API keys in publicly-accessible areas such as [GitHub](https://github.com/), client-side code, and so forth.\\n\\nAuthentication to the API is performed via [HTTP Basic Auth](https://tools.ietf.org/html/rfc7235). Provide your API key as the basic auth username value and your API secret as your password.\\n\\nExcept when site-to-site VPN is set up, all API requests must be made over [HTTPS](http://en.wikipedia.org/wiki/HTTP_Secure) with TLS 1.2.\\n\\nOn a side note, we strongly recommend securing your applications against common security flaws by employing best practices such as the [OWASP Top 10](https://www.owasp.org/index.php/Category:OWASP_Top_Ten_Project).\\n\",\"scheme\":\"basic\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
            source: "openapi3"
            version: 1
          }
          method: "POST"
          orig: "/async/transactions/{transaction_id}/confirm"
          segments: [
            {
              lit: "async"
            }
            {
              lit: "transactions"
            }
            {
              var: "transaction_id"
            }
            {
              lit: "confirm"
            }
          ]
          select: {
            "$action": "confirmAsync"
            exist: [
              "transaction_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "transaction_id"
                orig: "transaction_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          contract: {
            id: "POST /sync/transactions/{transaction_id}/confirm"
            json: "{\"operationId\":\"postTransactionConfirmSync\",\"parameters\":[{\"in\":\"path\",\"name\":\"transaction_id\",\"required\":true,\"schema\":{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"202\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"additional_identifier\":{\"description\":\"Additional details for a transaction. This information is mostly optional and will be required primarily for compliance reasons for products with additional information requirements as outlined in `required_additional_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"purchaser_id\":{\"description\":\"Anonymized ID related to the purchase for compliance reasons (e.g. terminal, POS, agent, end user, etc).\",\"pattern\":\"^[a-zA-Z0-9\\\\-]{8,36}$\",\"type\":\"string\"}},\"type\":\"object\"},\"adjusted_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"auto_confirm\":{\"default\":false,\"description\":\"Determines whether a transaction will be automatically confirmed upon creation or not. This is opted-out by default. Setting this field to `true` is recommended when transaction details, e.g. prices, are known as it removes the need to perform a separate API call to [confirm transactions](#operation/postTransactionConfirmAsync).\",\"type\":\"boolean\",\"writeOnly\":true},\"beneficiary\":{\"description\":\"Beneficiary details for a transaction. This information is mostly optional and will only be required for products with beneficiary information requirements as outlined in `required_beneficiary_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"address_postal_code\":{\"description\":\"Postal code.\",\"pattern\":\"^[A-Z0-9][A-Z0-9\\\\s\\\\-]*[A-Z0-9]$\",\"type\":\"string\"},\"address_text\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"email\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"first_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"last_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"middle_name\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"benefits\":{\"items\":{\"oneOf\":[{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Base benefit amount. A value of `-1` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"format\":\"double\",\"type\":\"number\"},\"promotion_bonus\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"total_excluding_tax\":{\"format\":\"double\",\"type\":\"number\"},\"total_including_tax\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"additional_information\":{\"nullable\":true,\"type\":\"string\"},\"amount\":{\"additionalProperties\":false,\"properties\":{\"base\":{\"additionalProperties\":false,\"description\":\"Base product benefits. A `-1` value for `min` or `max` indicates an unlimited benefit (e.g. unlimited data, calls, or SMS).\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"promotion_bonus\":{\"additionalProperties\":false,\"description\":\"Additional product benefits from applicable promotions.\",\"properties\":{\"max\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"},\"min\":{\"default\":0,\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_excluding_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions before taxes.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"},\"total_including_tax\":{\"additionalProperties\":false,\"description\":\"Product benefits including promotions after taxes. This field indicates the end benefits received by the end user.\",\"properties\":{\"max\":{\"format\":\"double\",\"type\":\"number\"},\"min\":{\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"min\",\"max\"],\"type\":\"object\"}},\"required\":[\"base\",\"promotion_bonus\",\"total_excluding_tax\",\"total_including_tax\"],\"type\":\"object\"},\"type\":{\"enum\":[\"TALKTIME\",\"DATA\",\"SMS\",\"PAYMENT\",\"CREDITS\"],\"type\":\"string\"},\"unit\":{\"type\":\"string\"},\"unit_type\":{\"enum\":[\"TIME\",\"DATA\",\"QUANTITY\",\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"type\",\"unit_type\",\"unit\",\"amount\",\"additional_information\"],\"type\":\"object\"}]},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"calculation_mode\":{\"allOf\":[{\"enum\":[\"SOURCE_AMOUNT\",\"DESTINATION_AMOUNT\"],\"type\":\"string\"},{\"nullable\":true},{\"writeOnly\":true},{\"description\":\"Required when product type is either `RANGED_VALUE_RECHARGE`, `RANGED_VALUE_PIN_PURCHASE`, or `RANGED_VALUE_PAYMENT`\"}]},\"confirmation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"confirmation_expiration_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"creation_date\":{\"format\":\"date-time\",\"readOnly\":true,\"type\":\"string\"},\"credit_party_identifier\":{\"description\":\"Receiving account details for a transaction. This information will be required for the majority of products with credit party inofrmation requirements outlined in `required_credit_party_identifier_fields`, but will be optional for certain products without any upfront recipient, e.g. Gift Cards.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"debit_party_identifier\":{\"description\":\"Sending account details for a transaction. This information is mostly optional and will only be required for products with debit party information requirements as outlined in `required_debit_party_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"account_number\":{\"description\":\"Account number.\",\"maxLength\":90,\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"account_qualifier\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"mobile_number\":{\"description\":\"Mobile number in [E.164](https://en.wikipedia.org/wiki/E.164) format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"}},\"type\":\"object\"},\"destination\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `DESTINATION_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"external_id\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"maxLength\":40},{\"description\":\"Unique identifier for the transaction in your system.\"}]},\"id\":{\"allOf\":[{\"description\":\"Unique transaction identifier.\",\"format\":\"int64\",\"minimum\":1,\"type\":\"integer\"}],\"readOnly\":true},\"metadata\":{\"allOf\":[{\"discriminator\":{\"mapping\":{\"ESIM\":\"#/components/schemas/transaction_metadata_esim\"},\"propertyName\":\"type\"},\"oneOf\":[{\"additionalProperties\":false,\"description\":\"eSIM transaction metadata.\",\"properties\":{\"activation_type\":{\"description\":\"Type of activation performed.\",\"enum\":[\"DATA_PLAN\",\"TOP_UP\"],\"type\":\"string\"},\"balance\":{\"additionalProperties\":false,\"description\":\"Balance information for the activated eSIM data package.\",\"properties\":{\"country_set\":{\"description\":\"Country set code (e.g., WWW for worldwide).\",\"type\":\"string\"},\"extended_data_policy\":{\"additionalProperties\":false,\"description\":\"Enriched with runtime state for an activated pack. Always returned. For STANDARD plans, only the type field will be returned.\",\"properties\":{\"fixed_time\":{\"description\":\"Time of day (HH:MM in UTC) when high-speed volume resets. Only present when reset_type is FIXED_TIME. Typically midnight (\\\"00:00\\\") but may vary due to time zone differences (e.g., \\\"08:00\\\").\",\"example\":\"00:00\",\"nullable\":true,\"pattern\":\"^\\\\d{2}:\\\\d{2}$\",\"type\":\"string\"},\"interval\":{\"description\":\"Interval duration for high-speed volume reset. Only present when reset_type is TIME_INTERVAL. For example, \\\"24h\\\" means the high-speed volume resets every 24 hours from activation.\",\"example\":\"24h\",\"nullable\":true,\"type\":\"string\"},\"reset_type\":{\"allOf\":[{\"description\":\"Method for resetting the high-speed data volume. Determines whether the interval or fixed_time field is returned. TIME_INTERVAL: high-speed volume resets on a recurring interval from activation (see interval field). FIXED_TIME: high-speed volume resets at a specific time of day (see fixed_time field). NONE: high-speed volume does not reset.\",\"enum\":[\"TIME_INTERVAL\",\"FIXED_TIME\",\"NONE\"],\"nullable\":true,\"type\":\"string\"},{\"nullable\":true}]},\"throttle_speed\":{\"description\":\"Speed to throttle to after high-speed volume is used up.\",\"example\":\"128 KB/s\",\"nullable\":true,\"type\":\"string\"},\"total_high_speed_volume\":{\"additionalProperties\":false,\"description\":\"Total high-speed data volume before throttling. Only populated when extended_data_policy type is UNLIMITED.\",\"nullable\":true,\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"type\":{\"description\":\"Package type.\",\"enum\":[\"STANDARD\",\"UNLIMITED\"],\"type\":\"string\"}},\"required\":[\"type\"],\"type\":\"object\"},\"size\":{\"additionalProperties\":false,\"description\":\"Total data size of the package.\",\"properties\":{\"amount\":{\"description\":\"Numeric value of the data size.\",\"format\":\"int64\",\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of the data size.\",\"enum\":[\"TB\",\"GB\",\"MB\",\"KB\",\"B\"],\"type\":\"string\"}},\"required\":[\"amount\",\"unit\"],\"type\":\"object\"},\"validity\":{\"additionalProperties\":false,\"description\":\"Remaining validity of the package.\",\"properties\":{\"quantity\":{\"description\":\"Original validity size of the activated item.\",\"example\":365,\"type\":\"integer\"},\"unit\":{\"description\":\"Unit of validity period.\",\"enum\":[\"YEAR\",\"MONTH\",\"WEEK\",\"DAY\",\"HOUR\",\"MINUTE\",\"SECOND\"],\"type\":\"string\"}},\"required\":[\"quantity\",\"unit\"],\"type\":\"object\"}},\"required\":[\"size\",\"validity\",\"country_set\",\"extended_data_policy\"],\"type\":\"object\"},\"profile\":{\"allOf\":[{\"additionalProperties\":false,\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\",\"nullable\":true,\"properties\":{\"activation_code\":{\"description\":\"QR code content for eSIM installation.\",\"type\":\"string\"},\"android_universal_link\":{\"description\":\"Universal link for eSIM installation on Android devices.\",\"format\":\"uri\",\"type\":\"string\"},\"apple_universal_link\":{\"description\":\"Universal link for eSIM installation on Apple devices.\",\"format\":\"uri\",\"type\":\"string\"},\"iccid\":{\"description\":\"Integrated Circuit Card Identifier.\",\"type\":\"string\"},\"installation_url\":{\"description\":\"Generic installation URL for the eSIM.\",\"format\":\"uri\",\"type\":\"string\"}},\"required\":[\"iccid\",\"activation_code\",\"apple_universal_link\",\"android_universal_link\",\"installation_url\"],\"type\":\"object\"}],\"description\":\"eSIM profile information. Only returned when activation_type is DATA_PLAN. Not present for TOP_UP transactions.\"},\"type\":{\"enum\":[\"ESIM\"],\"type\":\"string\"}},\"required\":[\"type\",\"activation_type\",\"balance\"],\"type\":\"object\"}]}],\"description\":\"Optional metadata related to the transaction. This can include any additional information that may be relevant\\nfor the transaction but is not covered by the other fields.\\nThe structure of this object can vary depending on the product type or service and specific use case.\\nFor example, for eSIM products, this field may contain additional details about the eSIM activation, balance and profile.\\n\",\"type\":\"object\"},\"operator_reference\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"readOnly\":true,\"type\":\"string\"},\"pin\":{\"nullable\":true,\"properties\":{\"code\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"serial\":{\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"required\":[\"code\",\"serial\"],\"type\":\"object\"},\"prices\":{\"additionalProperties\":false,\"properties\":{\"retail\":{\"additionalProperties\":false,\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"allOf\":[{\"enum\":[\"CURRENCY\"],\"type\":\"string\"},{\"nullable\":true}]}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"},\"wholesale\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"fee\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"allOf\":[{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},{\"nullable\":true}]},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\",\"fee\"],\"type\":\"object\"}},\"readOnly\":true,\"required\":[\"wholesale\",\"retail\"],\"type\":\"object\"},\"product\":{\"allOf\":[{\"properties\":{\"description\":{\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"operator\":{\"allOf\":[{\"properties\":{\"country\":{\"additionalProperties\":false,\"properties\":{\"iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"name\",\"iso_code\",\"regions\"],\"type\":\"object\"},\"id\":{\"description\":\"Operator identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"required\":[\"id\",\"name\",\"country\",\"regions\"],\"type\":\"object\"},{\"additionalProperties\":false}]},\"regions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"code\":{\"description\":\"Country subregion code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{2,3}(?:-[A-Z0-9]{2,3}(?:-[A-Z]{2})?)?$\",\"type\":\"string\"},\"name\":{\"type\":\"string\"}},\"required\":[\"name\",\"code\"],\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"service\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"description\":\"Service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"subservice\":{\"nullable\":true,\"properties\":{\"id\":{\"description\":\"Sub-service identifier. See [Services](#tags/Services) for more details.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"},\"name\":{\"type\":\"string\"}},\"type\":\"object\"}},\"required\":[\"id\",\"name\"],\"type\":\"object\"},\"tags\":{\"items\":{\"description\":\"Product tag.\",\"maxLength\":16,\"minLength\":4,\"pattern\":\"^[A-Z0-9_]+\",\"type\":\"string\"},\"maxItems\":1,\"minItems\":1,\"nullable\":true,\"type\":\"array\",\"uniqueItems\":true}},\"required\":[\"id\",\"name\",\"description\",\"tags\",\"service\",\"operator\",\"regions\"],\"type\":\"object\"},{\"properties\":{\"pin\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"terms\":{\"description\":\"Contains special conditions, as well as generic product Terms & Conditions. Formatted in [Markdown](https://en.wikipedia.org/wiki/Markdown).\",\"minLength\":1,\"nullable\":true,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"usage_info\":{\"items\