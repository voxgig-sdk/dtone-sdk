dity (e.g. `7` in `7 DAY`). A `null` value indicates validity is not known, while a value of `-1` indicates unlimited validity (i.e. no expiration).\",\"type\":\"integer\"},\"unit\":{\"enum\":[\"HOUR\",\"DAY\",\"WEEK\",\"MONTH\"],\"type\":\"string\"}},\"required\":[\"unit\",\"quantity\"],\"type\":\"object\"}},\"required\":[\"usage_info\",\"validity\",\"terms\"],\"type\":\"object\"},{\"nullable\":true}]},\"type\":{\"enum\":[\"FIXED_VALUE_RECHARGE\",\"RANGED_VALUE_RECHARGE\",\"FIXED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PIN_PURCHASE\",\"RANGED_VALUE_PAYMENT\"],\"type\":\"string\"}}},{\"readOnly\":true},{\"required\":[\"type\"]}]},\"product_id\":{\"allOf\":[{\"description\":\"Product identifier.\",\"format\":\"int32\",\"minimum\":1,\"type\":\"integer\"}],\"writeOnly\":true},\"promotions\":{\"items\":{\"additionalProperties\":false,\"properties\":{\"description\":{\"type\":\"string\"},\"end_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"id\":{\"type\":\"integer\"},\"start_date\":{\"format\":\"date-time\",\"type\":\"string\"},\"terms\":{\"nullable\":true,\"type\":\"string\"},\"title\":{\"type\":\"string\"}},\"required\":[\"id\",\"title\",\"description\",\"terms\",\"start_date\",\"end_date\"],\"type\":\"object\"},\"nullable\":true,\"readOnly\":true,\"type\":\"array\"},\"rates\":{\"allOf\":[{\"additionalProperties\":false,\"properties\":{\"base\":{\"description\":\"Exchange rate between the source amount and the destination amount.\",\"format\":\"double\",\"type\":\"number\"},\"retail\":{\"description\":\"Exchange rate between the retail price and the destination amount. A `null` value indicates retail prices are not configured, while a `-1` value indicates an infinite rate due to retail price being configured to a zero value.\",\"format\":\"double\",\"nullable\":true,\"type\":\"number\"},\"wholesale\":{\"description\":\"Exchange rate between the wholesale price and the destination amount.\",\"format\":\"double\",\"type\":\"number\"}},\"required\":[\"base\",\"wholes