 format.\",\"pattern\":\"^\\\\+[1-9][0-9]{6,14}$\",\"type\":\"string\"},\"nationality_country_iso_code\":{\"description\":\"Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format. Note that the official list can be extended with additional country codes.\",\"pattern\":\"^[A-Z]{3}$\",\"type\":\"string\"}},\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"description\":\"Required for ranged value products and when `calculation_mode` is set to `SOURCE_AMOUNT`\",\"nullable\":true,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\",\"writeOnly\":true},\"statement_identifier\":{\"description\":\"Qualifying statement details for a payment transaction. This information is mostly optional and will only be required for specific payment products with statement identifier requirements as outlined in `required_statement_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"due_date\":{\"format\":\"date\",\"type\":\"string\"},\"reference\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"properties\":{\"class\":{\"additionalProperties\":false,\"properties\":{\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"required\":[\"id\",\"message\"],\"type\":\"object\"},\"id\":{\"type\":\"integer\"},\"message\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"}},\"readOnly\":true,\"type\":\"object\"}},\"required\":[\"external_id\",\"product_id\"],\"type\":\"object\"}}}},\"responses\":{\"201\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"additional_identifier\":{\"description\":\"Additional details for a transaction. This information is mostly optional and will be required primarily for compliance reasons for products with additional information requirements as outlined in `required_additional_identifier_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"purchaser_id\":{\"description\":\"Anonymized ID related to the purchase for compliance reasons (e.g. terminal, POS, agent, end user, etc).\",\"pattern\":\"^[a-zA-Z0-9\\\\-]{8,36}$\",\"type\":\"string\"}},\"type\":\"object\"},\"adjusted_values\":{\"nullable\":true,\"properties\":{\"destination\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"},\"source\":{\"additionalProperties\":false,\"properties\":{\"amount\":{\"format\":\"double\",\"type\":\"number\"},\"unit\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"unit_type\":{\"enum\":[\"CURRENCY\"],\"type\":\"string\"}},\"required\":[\"unit_type\",\"unit\",\"amount\"],\"type\":\"object\"}},\"readOnly\":true,\"type\":\"object\"},\"auto_confirm\":{\"default\":false,\"description\":\"Determines whether a transaction will be automatically confirmed upon creation or not. This is opted-out by default. Setting this field to `true` is recommended when transaction details, e.g. prices, are known as it removes the need to perform a separate API call to [confirm transactions](#operation/postTransactionConfirmAsync).\",\"type\":\"boolean\",\"writeOnly\":true},\"beneficiary\":{\"description\":\"Beneficiary details for a transaction. This information is mostly optional and will only be required for products with beneficiary information requirements as outlined in `required_beneficiary_fields`.\",\"minProperties\":1,\"nullable\":true,\"properties\":{\"address_city\":{\"minLength\":1,\"pattern\":\"\\\\S\",\"type\":\"string\"},\"address_country_iso_code\":{\"description\":\"Country 