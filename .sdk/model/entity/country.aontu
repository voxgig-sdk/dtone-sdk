# Entity: country

main: kit: entity: country: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    iso_code: {
      h: "Iso Code"
      n: "iso_code"
      r: true
      sh: "Country code in [ISO 3166](https://www.iso.org/iso-3166-country-codes.html) format."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      t: "`$STRING`"
    }
    regions: {
      h: "Regions"
      n: "regions"
      r: true
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "country"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /countries"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 50
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "service_id"
                or: "service_id"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "subservice_id"
                or: "subservice_id"
                r: false
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/countries"
          q: {
            exist: [
              "page"
              "per_page"
              "service_id"
              "subservice_id"
            ]
          }
          s: [
            {
              lit: "countries"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /countries/{country_iso_code}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "country_iso_code"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/countries/{country_iso_code}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              country_iso_code: "id"
            }
          }
          s: [
            {
              lit: "countries"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
