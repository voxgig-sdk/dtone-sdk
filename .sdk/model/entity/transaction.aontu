    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /transactions"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "country_iso_code"
                or: "country_iso_code"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "credit_party_account_number"
                or: "credit_party_account_number"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "credit_party_mobile_number"
                or: "credit_party_mobile_number"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "external_id"
                or: "external_id"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "1970-01-01T00:00:00.000000Z"
                k: "query"
                n: "from_date"
                or: "from_date"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "operator_id"
