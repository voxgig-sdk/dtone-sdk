# Entity: transaction

main: kit: entity: transaction: {

  alias: field: {}

  fields: {
    additional_identifier: {
      h: "Additional Identifier"
      n: "additional_identifier"
      r: false
      sh: "Additional details for a transaction."
      t: "`$OBJECT`"
    }
    adjusted_values: {
      h: "Adjusted Values"
      n: "adjusted_values"
      r: false
      ro: true
      t: "`$OBJECT`"
    }
    auto_confirm: {
      h: "Auto Confirm"
      n: "auto_confirm"
      r: false
      sh: "Determines whether a transaction will be automatically confirmed upon creation or not."
      t: "`$BOOLEAN`"
      wo: true
    }
    beneficiary: {
      h: "Beneficiary"
      n: "beneficiary"
      r: false
      sh: "Beneficiary details for a transaction."
      t: "`$OBJECT`"
    }
    benefits: {
      h: "Benefits"
      n: "benefits"
      r: false
      ro: true
      t: "`$ARRAY`"
      union: {
        branches: 2
        count: 1
        depth: 1
      }
    }
    calculation_mode: {
      h: "Calculation Mode"
      n: "calculation_mode"
      r: false
      t: "`$ANY`"
    }
    callback_url: {
      fo: "uri"
      h: "Callback Url"
      n: "callback_url"
      r: false
      sh: "Transaction status updates will be sent to this endpoint."
      t: "`$STRING`"
    }
    confirmation_date: {
      fo: "date-time"
      h: "Confirmation Date"
      n: "confirmation_date"
      r: false
      ro: true
      t: "`$STRING`"
    }
    confirmation_expiration_date: {
      fo: "date-time"
      h: "Confirmation Expiration Date"
      n: "confirmation_expiration_date"
      r: false
      ro: true
      t: "`$STRING`"
    }
    creation_date: {
      fo: "date-time"
      h: "Creation Date"
      n: "creation_date"
      r: false
      ro: true
      t: "`$STRING`"
    }
    credit_party_identifier: {
      h: "Credit Party Identifier"
      n: "credit_party_identifier"
      r: false
      sh: "Receiving account details for a transaction."
      t: "`$OBJECT`"
    }
    debit_party_identifier: {
      h: "Debit Party Identifier"
      n: "debit_party_identifier"
      r: false
      sh: "Sending account details for a transaction."
      t: "`$OBJECT`"
    }
    destination: {
      h: "Destination"
      n: "destination"
      r: true
      sh: "Required for ranged value products and when `calculation_mode` is set to `DESTINATION_AMOUNT`"
      t: "`$OBJECT`"
      wo: true
    }
    external_id: {
      h: "External Id"
      n: "external_id"
      r: true
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      ro: true
      t: "`$STRING`"
    }
    metadata: {
      h: "Metadata"
      n: "metadata"
      r: false
      sh: "Optional metadata related to the transaction."
      t: "`$OBJECT`"
    }
    operator_reference: {
      h: "Operator Reference"
      n: "operator_reference"
      r: false
      ro: true
      t: "`$STRING`"
    }
    pin: {
      h: "Pin"
      n: "pin"
      r: true
      ro: true
      t: "`$OBJECT`"
    }
    prices: {
      h: "Prices"
      n: "prices"
      r: true
      ro: true
      t: "`$OBJECT`"
    }
    product: {
      h: "Product"
      n: "product"
      r: false
      t: "`$ANY`"
    }
    product_id: {
      h: "Product Id"
      n: "product_id"
      r: true
      t: "`$STRING`"
      wo: true
    }
    promotions: {
      h: "Promotions"
      n: "promotions"
      r: false
      ro: true
      t: "`$ARRAY`"
    }
    rates: {
      h: "Rates"
      n: "rates"
      r: false
      t: "`$ANY`"
    }
    requested_values: {
      h: "Requested Values"
      n: "requested_values"
      r: false
      ro: true
      t: "`$OBJECT`"
    }
    sender: {
      h: "Sender"
      n: "sender"
      r: false
      sh: "Sender details for a transaction."
      t: "`$OBJECT`"
    }
    source: {
      h: "Source"
      n: "source"
      r: true
      sh: "Required for ranged value products and when `calculation_mode` is set to `SOURCE_AMOUNT`"
      t: "`$OBJECT`"
      wo: true
    }
    statement_identifier: {
      h: "Statement Identifier"
      n: "statement_identifier"
      r: false
      sh: "Qualifying statement details for a payment transaction."
      t: "`$OBJECT`"
    }
    status: {
      h: "Status"
      n: "status"
      r: false
      ro: true
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "transaction"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /transactions/{transaction_id}/cancel"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "transaction_id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/transactions/{transaction_id}/cancel"
          q: {
            "$action": "cancel"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              transaction_id: "id"
            }
          }
          s: [
            {
              lit: "transactions"
            }
            {
              var: "id"
            }
            {
              lit: "cancel"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
