              }
            ]
          }
          method: "GET"
          orig: "/operators"
          parts: [
            "operators"
          ]
          select: {
            exist: [
              "country_iso_code"
              "page"
              "per_page"
              "service_id"
              "subservice_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
