# BasicCampaignFlow

main: kit: flow: BasicCampaignFlow:
{
  entity: "campaign",
  kind: "basic",
  name: "BasicCampaignFlow",
  step: [
    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "campaign_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "campaign_ref01",
        srcdatavar: "campaign_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "campaign01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-campaign_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCampaignFlow"
}