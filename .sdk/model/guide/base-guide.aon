# Guide

# apidef's heuristic got most of this right on the first pass (service,
# country, operator, benefit_type, promotion, campaign, product, balance
# all list/load correctly, path ids auto-renamed to `id`) -- those are
# re-declared here UNCHANGED, only because touching this file at all
# stops the heuristic from auto-classifying anything not explicitly
# listed (entity-gc removes anything absent).
#
# Real corrections, from reading the actual response schemas (not
# guessed): DT One's /lookup/* endpoints are POST-body queries, not
# resource creation -- the heuristic defaulted every POST to `create`.
# Three of the four actually return ARRAYS (list-shaped): mobile-number
# (candidate operators), statement-inquiry (statement lines),
# credit-party-benefits (benefit lines). Only credit-party-status
# returns a single object (load-shaped). `transaction` is the RPC-heavy
# one: async/sync are genuinely different creation paths (must stay
# distinguishable, not silently collapse to one `create` point), and
# confirm/cancel mutate an EXISTING transaction (op:update, not
# op:create, which is where the heuristic put them).

guide: {
  entity: service: {
    path: "/services": { op: list: method: *GET }
    path: "/services/{service_id}": { op: load: method: *GET }
  }

  entity: country: {
    path: "/countries": { op: list: method: *GET }
    path: "/countries/{country_iso_code}": { op: load: method: *GET }
  }

  entity: operator: {
    path: "/operators": { op: list: method: *GET }
    path: "/operators/{operator_id}": { op: load: method: *GET }
  }

  entity: benefit_type: {
    path: "/benefit-types": { op: list: method: *GET }
  }

  entity: promotion: {
    path: "/promotions": { op: list: method: *GET }
    path: "/promotions/{promotion_id}": { op: load: method: *GET }
  }

  entity: campaign: {
    path: "/campaigns": { op: list: method: *GET }
    path: "/campaigns/{campaign_id}": { op: load: method: *GET }
  }

  entity: product: {
    path: "/products": { op: list: method: *GET }
    path: "/products/{product_id}": { op: load: method: *GET }
  }

  entity: balance: {
    path: "/balances": { op: list: method: *GET }
  }

  entity: transaction: {
    path: "/async/transactions": {
      action: asyncCreate: {}
      op: create: method: *POST
    }
    path: "/sync/transactions": {
      action: syncCreate: {}
      op: create: method: *POST
    }
    path: "/transactions/{transaction_id}": {
      op: load: method: *GET
    }
    path: "/transactions": {
      op: list: method: *GET
    }
    path: "/async/transactions/{transaction_id}/confirm": {
      action: confirmAsync: {}
      op: update: method: *POST
    }
    path: "/sync/transactions/{transaction_id}/confirm": {
      action: confirmSync: {}
      op: update: method: *POST
    }
    path: "/transactions/{transaction_id}/cancel": {
      action: cancel: {}
      op: update: method: *POST
    }
  }

  entity: mobile_number_lookup: {
    path: "/lookup/mobile-number": { op: list: method: *POST }
    path: "/lookup/mobile-number/{mobile_number}": { op: list: method: *GET }
  }

  entity: statement_inquiry: {
    path: "/lookup/statement-inquiry": { op: list: method: *POST }
  }

  entity: credit_party_benefit: {
    path: "/lookup/credit-party-benefits": { op: list: method: *POST }
  }

  entity: credit_party_status: {
    path: "/lookup/credit-party-status": { op: load: method: *POST }
  }
}
